# ================================
# Nutrition Tracker Configuration
# ================================
# Скопируй этот файл как .env и заполни значения

# Google AI / Gemini API
# Получи ключ на https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_google_api_key_here

# Модель Gemini для всех агентов (по умолчанию gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Telegram Bot Token
# Получи у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Уровень логирования: DEBUG / INFO / WARNING / ERROR (по умолчанию INFO)
LOG_LEVEL=INFO

# ================================
# Cloud Run Configuration
# ================================
# URL вашего Cloud Run сервиса (заполняется после первого деплоя)
# Пример: https://nutrition-bot-xxxxx-uc.a.run.app
WEBHOOK_URL=

# ================================
# Turso Database (Cloud SQLite)
# ================================
# Регистрация: https://turso.tech
# Создание БД: turso db create nutrition-tracker
# Получить URL: turso db show nutrition-tracker --url
# Получить токен: turso db tokens create nutrition-tracker

# URL базы данных Turso
# Пример: libsql://nutrition-tracker-username.turso.io
TURSO_URL=

# Токен авторизации Turso
TURSO_TOKEN=

# ================================
# Сессии диалога (опционально)
# ================================
# Postgres для персистентных ADK-сессий (контекст разговора переживает рестарт).
# Если не задано — используется InMemory (контекст теряется при засыпании/рестарте).
# Пример Neon: postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
SESSION_DB_URL=
